[gd_resource type="Resource" script_class="CargoContractDefinition" load_steps=4 format=3]

[ext_resource type="Script" path="res://scripts/cargo_contract_definition.gd" id="1_contract"]
[ext_resource type="Script" path="res://scripts/cargo_item_definition.gd" id="2_item"]

[sub_resource type="Resource" id="CargoItemDefinition_provisions"]
script = ExtResource("2_item")
